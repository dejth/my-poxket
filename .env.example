# Copy this file to .env for local development only.
# Use fictional values and never commit a populated .env file.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

MARIADB_DATABASE=my_poxket_dev
MARIADB_USER=my_poxket_app
MARIADB_PASSWORD=replace-with-a-local-only-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-local-only-password
MARIADB_PORT=3307
DATABASE_URL=mysql://my_poxket_app:replace-with-a-local-only-password@127.0.0.1:3307/my_poxket_dev

# Development bootstrap credentials only. Production provisioning will use a
# controlled one-time command and secrets supplied outside the repository.
DEV_BOOTSTRAP_USERNAME=dev-owner
DEV_BOOTSTRAP_PASSWORD=replace-with-a-local-only-password
