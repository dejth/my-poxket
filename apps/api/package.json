{
  "name": "@my-poxket/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "auth:bootstrap": "tsx src/commands/bootstrap-owner.ts",
    "build": "tsc -p tsconfig.build.json",
    "categories:init": "tsx src/commands/initialize-categories.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/commands/migrate.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run src/finance/routes.integration.test.ts src/users/routes.integration.test.ts --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@my-poxket/domain": "0.0.0",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "mysql2": "3.24.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
