{
  "name": "@my-poxket/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "default": "./dist/calendar.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./transactions": {
      "types": "./dist/transactions.d.ts",
      "default": "./dist/transactions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
